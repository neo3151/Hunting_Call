rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───────────────────────────────────────────
    
    // Returns true if the requesting user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Returns true if the requesting user's UID matches the document ID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ─── /profiles/{userId} ─────────────────────────────────────────
    match /profiles/{userId} {
      // READ/CREATE: Standard owner access
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
                    && !request.resource.data.keys().hasAny(['premiumExpiresAt'])
                    && (!request.resource.data.keys().hasAny(['isPremium'])
                        || request.resource.data.isPremium == false);

      // UPDATE: Allow updating stats, but LOCK the isPremium field.
      // This prevents users from "hacking" themselves into a Pro subscription.
      allow update: if isOwner(userId) 
                    && (
                      // Only allow the update if isPremium isn't being changed by the client.
                      // Premium status should be handled via a secure Admin SDK or Cloud Function.
                      !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['isPremium', 'premiumExpiresAt'])
                    );

      // DELETE: Required for Google Play / App Store compliance.
      // Users MUST be able to delete their own data.
      allow delete: if isOwner(userId);
    }

    // ─── /leaderboards/{animalId} ───────────────────────────────────
    match /leaderboards/{animalId} {
      // Publicly readable for all authenticated hunters
      allow read: if isAuthenticated();

      // Client writes denied — updates must go through the submitScore Cloud Function
      allow write: if false;
    }

    // ─── /config/{document=**} ─────────────────────────────────────
    match /config/{document=**} {
      allow read: if true;
      allow write: if false; // Admin-only (Version enforcement, etc.)
    }

    // ─── /waitlist/{document} ─────────────────────────────────────
    match /waitlist/{document} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'source', 'timestamp', 'userAgent'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 0;
      allow read, update, delete: if false;
    }

    // ─── Admin Check Helper ─────────────────────────────────────────
    function isAdmin() {
      return isAuthenticated() && (request.auth.token.email == 'benchmarkappsllc@gmail.com' || request.auth.token.email == 'pongownsyou@gmail.com');
    }

    // ─── /bug_reports/{document} ────────────────────────────────────
    match /bug_reports/{document} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // ─── /general_feedback/{document} ───────────────────────────────
    match /general_feedback/{document} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // ─── Deny everything else ───────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
